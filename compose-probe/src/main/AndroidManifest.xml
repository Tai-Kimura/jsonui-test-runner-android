        <activity
            android:name="com.jsonui.testrunner.composeprobe.SliderProbeActivity"
            android:exported="false" />
        <activity
            android:name="com.jsonui.testrunner.composeprobe.ReorderProbeActivity"
            android:exported="false" />
    </application>
</manifest>
